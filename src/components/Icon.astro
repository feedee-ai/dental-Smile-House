---
// Иконки Phosphor (regular), одна семья на весь сайт.
import phone from '@phosphor-icons/core/assets/regular/phone.svg?raw';
import whatsapp from '@phosphor-icons/core/assets/regular/whatsapp-logo.svg?raw';
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import arrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';
import mapPin from '@phosphor-icons/core/assets/regular/map-pin.svg?raw';
import clock from '@phosphor-icons/core/assets/regular/clock.svg?raw';
import car from '@phosphor-icons/core/assets/regular/car.svg?raw';
import instagram from '@phosphor-icons/core/assets/regular/instagram-logo.svg?raw';
import check from '@phosphor-icons/core/assets/regular/check.svg?raw';
import tooth from '@phosphor-icons/core/assets/regular/tooth.svg?raw';
import microscope from '@phosphor-icons/core/assets/regular/microscope.svg?raw';
import scan from '@phosphor-icons/core/assets/regular/scan.svg?raw';
import cube from '@phosphor-icons/core/assets/regular/cube.svg?raw';
import x from '@phosphor-icons/core/assets/regular/x.svg?raw';
import google from '@phosphor-icons/core/assets/regular/google-logo.svg?raw';
import calendar from '@phosphor-icons/core/assets/regular/calendar-check.svg?raw';
import warning from '@phosphor-icons/core/assets/regular/warning-circle.svg?raw';
import list from '@phosphor-icons/core/assets/regular/list.svg?raw';
import translate from '@phosphor-icons/core/assets/regular/translate.svg?raw';

const icons = {
  phone, whatsapp, arrowUpRight, arrowRight, mapPin, clock, car, instagram, check,
  tooth, microscope, scan, cube, x, google, calendar, warning, list, translate,
};
export type IconName = keyof typeof icons;

interface Props { name: IconName; class?: string }
const { name, class: cls = '' } = Astro.props;
const svg = icons[name].replace('<svg ', `<svg aria-hidden="true" focusable="false" class="${cls}" `);
---
<Fragment set:html={svg} />
