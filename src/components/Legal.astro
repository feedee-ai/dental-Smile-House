---
// Aviso legal (LSSI-CE, art. 10), privacidad (RGPD) и cookies.
// ⚠️ Шаблон для демо: реквизиты клиники в [скобках] — заполнить и показать юристу клиники.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import MobileBar from './MobileBar.astro';
import { site, type Lang } from '../content/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const alternates = { es: '/legal/', ru: '/ru/legal/' };
const owner = site.titular?.name ?? (lang === 'es' ? '[titular pendiente]' : '[владелец уточняется]');
const nif = site.titular?.nif ?? (lang === 'es' ? '[NIF pendiente]' : '[NIF уточняется]');
const email = site.email ?? (lang === 'es' ? '[email pendiente]' : '[email уточняется]');
const reg = site.registroSanitario ?? (lang === 'es' ? '[pendiente]' : '[уточняется]');
const addr = `${site.address.street}, ${site.address.postalCode} ${site.address.city}`;
const title = lang === 'es' ? 'Aviso legal y privacidad | Smile House' : 'Правовая информация | Smile House';
---
<Base lang={lang} title={title} description={title} alternates={alternates} noindex>
  <Header lang={lang} alternates={alternates} onHome={false} />
  <main class="wrap max-w-3xl py-16 md:py-24">
    {lang === 'es' ? (
      <article class="legal">
        <h1>Aviso legal y privacidad</h1>

        <h2>Titular del sitio web</h2>
        <p>
          En cumplimiento del artículo 10 de la Ley 34/2002, de Servicios de la Sociedad de la Información (LSSI-CE):
          titular: {owner}; NIF: {nif}; domicilio: {addr}; teléfono: {site.phone.display}; email: {email}.
          Centro sanitario inscrito en el registro de la Conselleria de Sanidad de la Generalitat Valenciana con el número {reg}.
        </p>

        <h2>Protección de datos</h2>
        <p><strong>Responsable:</strong> {owner}, {addr}.</p>
        <p><strong>Qué datos tratamos:</strong> nombre, teléfono, forma de contacto preferida y, si lo indicas, el motivo de la consulta.</p>
        <p><strong>Para qué:</strong> llamarte o escribirte para dar cita. No enviamos publicidad.</p>
        <p><strong>Base legal:</strong> tu consentimiento al enviar el formulario (art. 6.1.a y, para el motivo de la consulta, art. 9.2.a del RGPD). Puedes retirarlo en cualquier momento.</p>
        <p><strong>Cuánto tiempo:</strong> hasta gestionar la cita y, como máximo, [plazo pendiente]. Si pasas a ser paciente, se aplica la normativa de historia clínica.</p>
        <p><strong>Quién más lo ve:</strong> el proveedor de alojamiento (Vercel Inc.) y el servicio de mensajería con el que la recepción recibe las solicitudes. [Revisar proveedores y transferencias internacionales antes de publicar.]</p>
        <p><strong>Tus derechos:</strong> acceso, rectificación, supresión, oposición, limitación y portabilidad, escribiendo a {email}. Puedes reclamar ante la Agencia Española de Protección de Datos (aepd.es).</p>

        <h2 id="cookies">Cookies</h2>
        <p>Este sitio no usa cookies de publicidad ni de analítica. Guardamos en tu navegador solo tu elección sobre el mapa.</p>
        <p>El mapa de Google Maps se carga únicamente si lo permites. Al cargarlo, Google puede instalar sus propias cookies; consulta su política en policies.google.com.</p>
        <p><button type="button" data-open-cookies class="btn btn-line min-h-11">Cambiar mi elección</button></p>
      </article>
    ) : (
      <article class="legal">
        <h1>Правовая информация</h1>

        <h2>Владелец сайта</h2>
        <p>
          В соответствии со статьёй 10 Закона 34/2002 об услугах информационного общества (LSSI-CE):
          владелец: {owner}; NIF: {nif}; адрес: {addr}; телефон: {site.phone.display}; email: {email}.
          Медицинский центр внесён в реестр Conselleria de Sanidad Валенсийского сообщества под номером {reg}.
        </p>

        <h2>Персональные данные</h2>
        <p><strong>Ответственный:</strong> {owner}, {addr}.</p>
        <p><strong>Какие данные:</strong> имя, телефон, удобный способ связи и, если укажете, повод обращения.</p>
        <p><strong>Зачем:</strong> чтобы позвонить или написать вам и записать на приём. Рекламу не отправляем.</p>
        <p><strong>Основание:</strong> ваше согласие при отправке формы (ст. 6.1.a и, для повода обращения, ст. 9.2.a GDPR). Его можно отозвать в любой момент.</p>
        <p><strong>Сколько храним:</strong> до записи на приём, но не дольше [срок уточняется]. Если вы станете пациентом, действуют правила о медицинской карте.</p>
        <p><strong>Кто ещё видит данные:</strong> хостинг (Vercel Inc.) и мессенджер, через который администратор получает заявки. [Проверить список подрядчиков и международную передачу данных до публикации.]</p>
        <p><strong>Ваши права:</strong> доступ, исправление, удаление, возражение, ограничение и переносимость. Пишите на {email}. Жалобу можно подать в Agencia Española de Protección de Datos (aepd.es).</p>

        <h2 id="cookies">Cookies</h2>
        <p>Сайт не использует рекламные и аналитические cookies. В браузере сохраняется только ваш выбор насчёт карты.</p>
        <p>Карта Google загружается, только если вы разрешите. После этого Google может установить свои cookies; их политика: policies.google.com.</p>
        <p><button type="button" data-open-cookies class="btn btn-line min-h-11">Изменить выбор</button></p>
      </article>
    )}
  </main>
  <Footer lang={lang} />
  <MobileBar lang={lang} onHome={false} />
</Base>

<style>
  .legal :global(h1) {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }
  .legal :global(h2) {
    margin-top: 3rem;
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .legal :global(p) {
    margin-top: 1rem;
    max-width: 68ch;
    line-height: 1.7;
    color: var(--color-ink-soft);
  }
  .legal :global(strong) { color: var(--color-ink); font-weight: 600; }
</style>
