---
// ⚠️ Звёзды в выгрузке отзывов не сохранились. Сейчас у всех положительных
// стоит 5 — для демо, по просьбе. Перед публикацией сверить с Google
// (поле `rating` в src/content/reviews.ts).
interface Props { value?: number; class?: string; label?: string }
const { value = 5, class: cls = '', label } = Astro.props;
const path = 'M234.29,114.85l-45,38.83L203,211.75a16.4,16.4,0,0,1-24.5,17.82L128,198.49,77.47,229.57A16.4,16.4,0,0,1,53,211.75l13.76-58.07-45-38.83A16.46,16.46,0,0,1,31.08,86l59-4.76,22.76-55.08a16.36,16.36,0,0,1,30.27,0l22.75,55.08,59,4.76a16.46,16.46,0,0,1,9.37,28.86Z';
---
<span class:list={['inline-flex items-center gap-0.5', cls]} role="img" aria-label={label ?? `${value} / 5`}>
  {Array.from({ length: 5 }, (_, i) => (
    <svg viewBox="0 0 256 256" class:list={['size-[1em]', i < value ? 'opacity-100' : 'opacity-25']} fill="currentColor" aria-hidden="true"><path d={path} /></svg>
  ))}
</span>
