---
import Icon from './Icon.astro';
import { copy } from '../content/copy';
import type { Lang } from '../content/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang].services;
---
<section id="tratamientos" class="wrap py-20 md:py-28" aria-labelledby="services-title">
  <h2 id="services-title" class="text-[2.25rem] font-medium leading-[1.08] tracking-[-0.025em] md:text-[3.25rem]">{t.title}</h2>
  <p class="mt-5 max-w-[46ch] text-[1.0625rem] leading-relaxed text-ink-soft">{t.lead}</p>

  <ol class="mt-12 mb-10 border-b border-ink/80 md:mt-16 md:mb-14">
    {t.featured.map((s) => (
      <li class="group grid gap-3 border-t border-ink/80 py-8 md:grid-cols-12 md:gap-8 md:py-10">
        <h3 class="text-[1.75rem] font-medium leading-[1.12] tracking-[-0.02em] md:col-span-7 md:text-[2.5rem]">
          <span class="bg-[linear-gradient(var(--color-coral),var(--color-coral))] bg-no-repeat bg-[length:0%_100%] transition-[background-size] duration-500 ease-[var(--ease-out)] group-hover:bg-[length:100%_100%] [box-decoration-break:clone]">{s.title}</span>
        </h3>
        <p class="max-w-[44ch] text-[1.0625rem] leading-relaxed text-ink-soft md:col-span-5 md:pt-2">{s.text}</p>
      </li>
    ))}
  </ol>

  <ul class="grid gap-px overflow-hidden rounded-[4px] border border-line bg-line sm:grid-cols-2 lg:grid-cols-5">
    {t.rest.map((s, i) => {
      const urgent = i === t.rest.length - 1;
      return (
        <li class:list={['flex flex-col p-6', urgent ? 'bg-coral' : 'bg-porcelain']}>
          <h3 class="font-display text-[1.1875rem] font-medium leading-snug">{s.title}</h3>
          <p class:list={['mt-2 text-[0.9375rem] leading-relaxed', urgent ? 'text-ink' : 'text-graphite']}>{s.text}</p>
          {urgent && (
            <a href="#cita" class="link-arrow mt-auto pt-4 text-[0.9375rem] text-ink">
              {copy[lang].cta.book}<Icon name="arrowRight" />
            </a>
          )}
        </li>
      );
    })}
  </ul>
</section>
