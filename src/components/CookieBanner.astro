---
// Сайт не ставит рекламных и аналитических cookies. Согласие нужно только
// для карты Google (сторонний iframe). Кнопки «принять» и «отклонить» равнозначны (AEPD).
import { copy } from '../content/copy';
import { legalPath, type Lang } from '../content/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang].cookie;
---
<div
  id="cookie-banner"
  role="region"
  aria-label="Cookies"
  hidden
  class="fixed inset-x-3 bottom-[calc(5.25rem+env(safe-area-inset-bottom))] z-50 mx-auto max-w-xl rounded-[4px] bg-ink p-5 text-porcelain shadow-[0_18px_50px_-12px_rgb(0_0_0/0.45)] md:bottom-6 md:left-6 md:right-auto md:mx-0"
>
  <p class="text-[0.9375rem] leading-relaxed text-porcelain/90">
    {t.text}
    <a href={`${legalPath(lang)}#cookies`} class="underline decoration-porcelain/40 hover:decoration-porcelain">{t.more}</a>
  </p>
  <div class="mt-4 grid grid-cols-2 gap-2">
    <button type="button" data-consent="denied" class="btn btn-line-light min-h-11 px-4 text-[0.9375rem]">{t.reject}</button>
    <button type="button" data-consent="granted" class="btn btn-coral min-h-11 px-4 text-[0.9375rem]">{t.accept}</button>
  </div>
</div>

<script>
  const KEY = 'sh-consent-maps';
  const banner = document.getElementById('cookie-banner');

  function read(): string | null {
    try { return localStorage.getItem(KEY); } catch { return null; }
  }
  function write(v: string) {
    try { localStorage.setItem(KEY, v); } catch {}
    document.dispatchEvent(new CustomEvent('sh:consent', { detail: v }));
  }

  if (banner) {
    const show = () => {
      banner.hidden = false;
      banner.animate(
        [{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'none' }],
        { duration: 320, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
      );
    };
    if (!read()) setTimeout(show, 900);

    banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((b) =>
      b.addEventListener('click', () => {
        write(b.dataset.consent!);
        banner.hidden = true;
      }),
    );
    document.querySelectorAll('[data-open-cookies]').forEach((el) =>
      el.addEventListener('click', (e) => {
        e.preventDefault();
        show();
      }),
    );
  }
</script>
