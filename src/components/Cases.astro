---
// Случаи, за которые берутся не все: до/после из постов клиники + фото работы.
// Снимков КТ здесь нет — пациенту они непонятны.
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { copy } from '../content/copy';
import { cases } from '../content/cases';
import { reviewById, quoteFor } from '../content/reviews';
import { site, type Lang } from '../content/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang].cases;
const featured = cases.filter((c) => c.ba);
const rest = cases.filter((c) => !c.ba);
---
<section id="casos" class="bg-paper" aria-labelledby="cases-title">
  <div class="wrap py-20 md:py-28">
    <h2 id="cases-title" class="max-w-[18ch] text-[2.25rem] font-medium leading-[1.08] tracking-[-0.025em] md:text-[3.25rem]">
      {t.title}
    </h2>
    <p class="mt-5 max-w-[56ch] text-[1.0625rem] leading-relaxed text-ink-soft">{t.lead}</p>

    <div class="mt-12 grid gap-10 md:mt-16 lg:grid-cols-2 lg:gap-8">
      {featured.map((c) => (
        <article class="flex flex-col">
          <div class="grid gap-1 overflow-hidden rounded-[4px] bg-ink p-1">
            {c.ba!.map((ph, i) => (
              <figure class="relative overflow-hidden rounded-[2px]">
                <Photo name={ph} alt={`${i === 0 ? t.before : t.after}: ${c.title[lang]}`} sizes="(min-width: 1024px) 45vw, 92vw" class="aspect-[2.4/1] w-full object-cover" />
                <figcaption class="absolute bottom-2 left-2 rounded-[3px] bg-black/60 px-2 py-0.5 text-[0.75rem] text-porcelain">{i === 0 ? t.before : t.after}</figcaption>
              </figure>
            ))}
          </div>
          <p class="mt-6 text-[0.8125rem] font-medium uppercase tracking-[0.1em] text-coral-deep">{c.tag[lang]}</p>
          <h3 class="mt-2 text-[1.625rem] font-medium leading-tight tracking-[-0.015em] md:text-[1.875rem]">{c.title[lang]}</h3>
          <p class="mt-3 max-w-[56ch] leading-relaxed text-ink-soft">{c.text[lang]}</p>
          <a href={c.url} target="_blank" rel="noopener" class="link-arrow mt-5 self-start text-[0.9375rem]">{t.open}<Icon name="arrowUpRight" /></a>
        </article>
      ))}
    </div>

    <ul class="mt-16 grid gap-px overflow-hidden rounded-[4px] border border-line bg-line sm:grid-cols-2 md:mt-20 lg:grid-cols-4">
      {rest.map((c) => {
        const r = c.quote ? reviewById(c.quote) : null;
        const q = r ? quoteFor(r, lang) : null;
        return (
          <li class="group flex flex-col bg-porcelain p-5 sm:p-6">
            {c.photo && (
              <div class="mb-5 overflow-hidden rounded-[2px]">
                <Photo name={c.photo} alt={c.title[lang]} sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw" class="aspect-[4/3] w-full object-cover grayscale transition-transform duration-700 ease-[var(--ease-out)] group-hover:scale-[1.04]" />
              </div>
            )}
            <p class="text-[0.75rem] font-medium uppercase tracking-[0.1em] text-coral-deep">{c.tag[lang]}</p>
            <h3 class="mt-2 font-display text-[1.25rem] font-medium leading-snug tracking-[-0.01em]">{c.title[lang]}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-graphite">{c.text[lang]}</p>
            {r && q && (
              <blockquote class="mt-4 border-l-2 border-coral pl-3 text-[0.9375rem] leading-relaxed text-ink">
                <p>«{q.text}»</p>
                <footer class="mt-1.5 text-[0.8125rem] text-graphite">
                  {t.quoteFrom} <span class="font-medium text-ink">{r.author}</span>,{' '}
                  <a href={site.reviewsUrl} target="_blank" rel="noopener" class="underline decoration-ink/25 hover:decoration-ink">Google</a>
                  {q.note && <span class="block">{q.note}</span>}
                </footer>
              </blockquote>
            )}
            <a href={c.url} target="_blank" rel="noopener" class="link-arrow mt-auto self-start pt-5 text-[0.875rem]">{t.open}<Icon name="arrowUpRight" /></a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
