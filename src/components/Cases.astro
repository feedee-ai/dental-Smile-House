---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import Stars from './Stars.astro';
import { beforeAfter } from '../content/photos';
import { copy } from '../content/copy';
import { cases } from '../content/cases';
import { reviewById, quoteFor } from '../content/reviews';
import { site, type Lang } from '../content/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const [lead, ...rest] = cases;
const extra = quoteFor(reviewById('bynkalo'), lang);
---
<section id="casos" class="bg-ink text-porcelain" aria-labelledby="cases-title">
  <div class="wrap py-20 md:py-28">
    <h2 id="cases-title" class="max-w-[18ch] text-[2.25rem] font-medium leading-[1.08] tracking-[-0.025em] md:text-[3.25rem]">
      {t.cases.title}
    </h2>
    <p class="mt-5 max-w-[56ch] text-[1.0625rem] leading-relaxed text-porcelain/70">{t.cases.lead}</p>

    <div class="mt-12 md:mt-16">
      <ul class="-mx-5 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 pb-2 md:mx-0 md:grid md:grid-cols-3 md:gap-4 md:overflow-visible md:px-0 md:pb-0">
        {beforeAfter.map((name, i) => (
          <li class="w-[82%] shrink-0 snap-center md:w-auto">
            <figure class="ba overflow-hidden rounded-[4px] bg-porcelain/5">
              <Photo name={name} alt={t.cases.baAlt} sizes="(min-width: 768px) 33vw, 82vw" class="aspect-square w-full object-cover transition-transform duration-700 ease-[var(--ease-out)]" />
            </figure>
          </li>
        ))}
      </ul>
      <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.9375rem] text-porcelain/65">
        <span class="font-display text-[1.125rem] font-medium text-porcelain">{t.cases.baTitle}</span>
        <span>{t.cases.baNote}</span>
        <a href={site.instagram.url} target="_blank" rel="noopener" class="link-arrow text-porcelain/90">{site.instagram.handle}<Icon name="arrowUpRight" /></a>
      </p>
    </div>

    <div class="mt-16 grid gap-px overflow-hidden rounded-[4px] bg-porcelain/12 md:mt-20 lg:grid-cols-12">
      <article class="flex flex-col bg-ink p-6 sm:p-8 lg:col-span-6 lg:row-span-3 lg:p-10">
        {lead.photo && <img src={lead.photo} alt="" class="mb-8 aspect-[4/3] w-full rounded-[2px] object-cover" loading="lazy" />}
        {lead.figure && (
          <p class="font-display font-medium leading-none tracking-[-0.04em]">
            <span class="block text-[5.5rem] text-coral sm:text-[7.5rem] lg:text-[9rem]">{lead.figure[lang]}</span>
            <span class="mt-3 block text-[1.0625rem] font-normal tracking-normal text-porcelain/70">{lead.figureNote?.[lang]}</span>
          </p>
        )}
        <h3 class="mt-10 text-[1.625rem] font-medium leading-tight tracking-[-0.015em] lg:mt-auto lg:pt-12">{lead.title[lang]}</h3>
        <p class="mt-3 max-w-[52ch] leading-relaxed text-porcelain/75">{lead.text[lang]}</p>
        <a href={lead.url} target="_blank" rel="noopener" class="link-arrow mt-6 self-start text-porcelain">
          {t.cases.open}<Icon name="arrowUpRight" />
        </a>
      </article>

      {rest.map((c) => (
        <article class="group flex flex-col bg-ink p-6 transition-colors duration-300 hover:bg-[#1a1a1a] sm:p-8 lg:col-span-6 lg:p-10">
          {c.photo && <img src={c.photo} alt="" class="mb-6 aspect-[3/2] w-full rounded-[2px] object-cover" loading="lazy" />}
          <h3 class="text-[1.375rem] font-medium leading-tight tracking-[-0.01em]">{c.title[lang]}</h3>
          <p class="mt-3 max-w-[56ch] leading-relaxed text-porcelain/75">{c.text[lang]}</p>
          <a href={c.url} target="_blank" rel="noopener" class="link-arrow mt-5 self-start text-[0.9375rem] text-porcelain/90">
            {t.cases.open}<Icon name="arrowUpRight" />
          </a>
        </article>
      ))}
    </div>

    <figure class="mt-16 max-w-3xl md:mt-20">
      <Stars class="mb-5 text-[1.125rem] text-coral" />
      <blockquote class="font-display text-[1.5rem] leading-[1.35] tracking-[-0.01em] md:text-[2rem]">
        <p>«{extra.text}»</p>
      </blockquote>
      <figcaption class="mt-5 flex flex-wrap items-center gap-x-3 text-[0.9375rem] text-porcelain/65">
        <span class="font-medium text-porcelain">{reviewById('bynkalo').author}</span>
        <a href={site.reviewsUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 underline decoration-porcelain/30 hover:decoration-porcelain"><Icon name="google" class="size-4" />Google</a>
        {extra.note && <span>{extra.note}</span>}
      </figcaption>
    </figure>
  </div>
</section>

<style>
  @media (hover: hover) {
    .ba:hover :global(img) { transform: scale(1.03); }
  }
</style>
