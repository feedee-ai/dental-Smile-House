---
import Icon, { type IconName } from './Icon.astro';
import Photo from './Photo.astro';
import Stars from './Stars.astro';
import { copy } from '../content/copy';
import { reviewById, quoteFor } from '../content/reviews';
import { site, type Lang } from '../content/site';
import type { PhotoName } from '../content/photos';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang].visit;
// Отзыв о страхе — на языке оригинала страницы, если есть.
const fear = reviewById(lang === 'es' ? 'iglesia' : 'anders');
const fq = quoteFor(fear, lang);
---
<section id="primera-visita" class="wrap py-20 md:py-28" aria-labelledby="visit-title">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <div>
        <h2 id="visit-title" class="max-w-[14ch] text-[2.25rem] font-medium leading-[1.08] tracking-[-0.025em] md:text-[3.25rem]">
          {t.title}
        </h2>
        <p class="mt-5 max-w-[40ch] text-[1.0625rem] leading-relaxed text-ink-soft">{t.lead}</p>

        <figure class="mt-10">
          <Photo name="visit-explain" alt={t.photoAlt} sizes="(min-width: 1024px) 38vw, 100vw" class="mb-6 aspect-[4/3] w-full rounded-[4px] object-cover object-[50%_30%] grayscale" />
          <Stars class="mb-3 text-[0.9375rem] text-coral-deep" />
          <blockquote class="text-[1.125rem] leading-relaxed text-ink">
            <p>«{fq.text}»</p>
          </blockquote>
          <figcaption class="mt-3 flex flex-wrap gap-x-3 text-[0.875rem] text-graphite">
            <span class="font-medium text-ink">{fear.author}</span>
            <a href={site.reviewsUrl} target="_blank" rel="noopener" class="underline decoration-ink/25 hover:decoration-ink">Google</a>
            {fq.note && <span>{fq.note}</span>}
          </figcaption>
        </figure>
      </div>
    </div>

    <ol class="relative lg:col-span-7">
      {t.steps.map((s, i) => (
        <li class="relative grid grid-cols-[2.5rem_1fr] gap-x-4 pb-10 last:pb-0 md:grid-cols-[3.5rem_1fr]">
          {i < t.steps.length - 1 && <span class="absolute bottom-0 left-[1.25rem] top-12 w-px bg-line md:left-[1.75rem]" aria-hidden="true" />}
          <span class="flex size-10 items-center justify-center rounded-full border border-ink/20 bg-porcelain font-display text-[1.0625rem] font-medium tabular md:size-14 md:text-[1.25rem]" aria-hidden="true">
            {i + 1}
          </span>
          <div class="pt-1.5 md:pt-3">
            <h3 class="text-[1.375rem] font-medium leading-tight tracking-[-0.01em] md:text-[1.625rem]">{s.title}</h3>
            <p class="mt-2 max-w-[48ch] leading-relaxed text-ink-soft">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <div class="mt-20 md:mt-28">
    <h3 class="text-[1.625rem] font-medium tracking-[-0.015em] md:text-[2rem]">{t.equipmentTitle}</h3>
    <ul class="-mx-5 mt-6 flex snap-x snap-mandatory scroll-px-5 gap-3 overflow-x-auto px-5 pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-4 sm:overflow-visible sm:px-0 lg:grid-cols-4">
      {t.equipment.map((e) => (
        <li class="eq w-[68%] shrink-0 snap-start sm:w-auto">
          <div class="overflow-hidden rounded-[4px] bg-ink">
            <Photo name={e.photo as PhotoName} alt={e.label} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 68vw" class="aspect-[4/5] w-full object-cover grayscale transition-transform duration-700 ease-[var(--ease-out)]" />
          </div>
          <p class="mt-3 flex items-start gap-2.5 font-display text-[1.0625rem] font-medium leading-snug">
            <Icon name={e.icon as IconName} class="mt-0.5 size-5 shrink-0" />{e.label}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  @media (hover: hover) {
    .eq:hover :global(img) { transform: scale(1.04); }
  }
</style>
