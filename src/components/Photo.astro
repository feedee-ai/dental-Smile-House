---
import { photoSizes, type PhotoName } from '../content/photos';

interface Props {
  name: PhotoName;
  alt: string;
  class?: string;
  sizes?: string;
  eager?: boolean;
}
const { name, alt, class: cls = '', sizes = '(min-width: 1024px) 50vw, 100vw', eager = false } = Astro.props;
const [w, h] = photoSizes[name];
const src = (px: number) => `/photos/${name}-${px}.webp`;
---
<img
  src={src(1280)}
  srcset={`${src(720)} 720w, ${src(1280)} ${w}w`}
  sizes={sizes}
  width={w}
  height={h}
  alt={alt}
  class={cls}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
