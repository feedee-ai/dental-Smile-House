---
// Несколько отзывов в одном месте: сменяются сами каждые ~7 с, точки — ручное
// переключение. Все цитаты лежат в одной ячейке грида, поэтому высота блока —
// по самой длинной, и при смене ничего не прыгает. На наведении и фокусе стоит;
// при prefers-reduced-motion сам не листает. Без JS видна первая цитата.
import Icon from './Icon.astro';
import Stars from './Stars.astro';
import { site } from '../content/site';

export type RotatorItem = {
  text: string;
  author: string;
  note?: string | null;
  tag?: string;
};

interface Props {
  items: RotatorItem[];
  // dark — на тёмном фоне (hero), light — на светлом.
  tone?: 'dark' | 'light';
  size?: 'md' | 'lg';
  label: string;
  googleLabel?: string;
  class?: string;
}
const { items, tone = 'dark', size = 'md', label, googleLabel = 'Google', class: cls = '' } = Astro.props;
const dark = tone === 'dark';
---
<div class:list={['qr', cls]} data-qr role="region" aria-roledescription="carousel" aria-label={label}>
  <div class="grid">
    {items.map((q, i) => (
      <figure
        class:list={['qr-item col-start-1 row-start-1 flex flex-col', i === 0 && 'is-on']}
        aria-hidden={i === 0 ? undefined : 'true'}
        data-qr-item
      >
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <Stars class={dark ? 'text-[1rem] text-coral' : 'text-[1rem] text-coral-deep'} label="5 / 5" />
          {q.tag && (
            <span class:list={['rounded-full px-2.5 py-0.5 text-[0.75rem] font-medium tracking-[0.01em]', dark ? 'bg-porcelain/12 text-porcelain/85' : 'bg-ink/[0.06] text-ink-soft']}>{q.tag}</span>
          )}
        </div>
        <blockquote
          class:list={[
            'mt-4 font-display font-normal tracking-[-0.01em]',
            size === 'lg' ? 'text-[1.5rem] leading-[1.32] md:text-[2.25rem] md:leading-[1.25]' : 'text-[1.25rem] leading-[1.34] sm:text-[1.5rem]',
          ]}
        >
          <p>«{q.text}»</p>
        </blockquote>
        <figcaption class:list={['mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.9375rem]', dark ? 'text-porcelain/65' : 'text-graphite']}>
          <span class:list={['font-medium', dark ? 'text-porcelain' : 'text-ink']}>{q.author}</span>
          <a href={site.reviewsUrl} target="_blank" rel="noopener" tabindex={i === 0 ? undefined : -1} class:list={['inline-flex items-center gap-1.5 underline', dark ? 'decoration-porcelain/30 hover:decoration-porcelain' : 'decoration-ink/25 hover:decoration-ink']}>
            <Icon name="google" class="size-4" />{googleLabel}
          </a>
          {q.note && <span class:list={['w-full text-[0.8125rem]', dark ? 'text-porcelain/45' : 'text-mist']}>{q.note}</span>}
        </figcaption>
      </figure>
    ))}
  </div>

  {items.length > 1 && (
    <div class="mt-6 flex items-center gap-1" data-qr-dots>
      {items.map((q, i) => (
        <button
          type="button"
          class:list={['qr-dot', dark ? 'qr-dot-dark' : 'qr-dot-light']}
          aria-label={`${i + 1} / ${items.length}: ${q.author}`}
          aria-current={i === 0 ? 'true' : undefined}
          data-qr-dot={i}
        ><span></span></button>
      ))}
    </div>
  )}
</div>

<style>
  .qr-item {
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 500ms var(--ease-out), transform 500ms var(--ease-out), visibility 0s linear 500ms;
  }
  .qr-item.is-on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 600ms var(--ease-out) 120ms, transform 600ms var(--ease-out) 120ms, visibility 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .qr-item, .qr-item.is-on { transform: none; transition: none; }
  }
  /* Кнопка 32×32 для пальца, видимая часть — короткая полоска. */
  .qr-dot { display: grid; place-items: center; width: 2rem; height: 2rem; }
  .qr-dot span {
    display: block; width: 0.875rem; height: 3px; border-radius: 2px;
    transition: width 300ms var(--ease-out), background-color 300ms;
  }
  .qr-dot-dark span { background: rgb(251 251 250 / 0.3); }
  .qr-dot-light span { background: rgb(18 18 18 / 0.2); }
  .qr-dot[aria-current='true'] span { width: 1.75rem; }
  .qr-dot-dark[aria-current='true'] span { background: var(--color-coral); }
  .qr-dot-light[aria-current='true'] span { background: var(--color-coral-deep); }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-qr]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>('[data-qr-item]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-qr-dot]')];
    if (items.length < 2) return;
    let cur = 0;
    let timer: number | undefined;
    let visible = false;
    let hold = false;

    const show = (n: number) => {
      cur = (n + items.length) % items.length;
      items.forEach((el, i) => {
        const on = i === cur;
        el.classList.toggle('is-on', on);
        if (on) el.removeAttribute('aria-hidden'); else el.setAttribute('aria-hidden', 'true');
        el.querySelectorAll('a').forEach((a) => (on ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
      });
      dots.forEach((d, i) => (i === cur ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    };
    const stop = () => { clearInterval(timer); timer = undefined; };
    const start = () => {
      stop();
      if (reduce || hold || !visible) return;
      timer = window.setInterval(() => show(cur + 1), 7000);
    };

    dots.forEach((d) => d.addEventListener('click', () => { show(Number(d.dataset.qrDot)); start(); }));
    root.addEventListener('pointerenter', () => { hold = true; stop(); });
    root.addEventListener('pointerleave', () => { hold = false; start(); });
    root.addEventListener('focusin', () => { hold = true; stop(); });
    root.addEventListener('focusout', () => { hold = false; start(); });
    // Листаем только когда блок на экране.
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; start(); }, { threshold: 0.3 }).observe(root);
  });
</script>
