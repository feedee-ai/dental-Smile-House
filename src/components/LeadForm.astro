---
import Icon from './Icon.astro';
import { copy } from '../content/copy';
import { site, legalPath, type Lang } from '../content/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang].form;
---
<section id="cita" class="bg-coral" aria-labelledby="form-title">
  <div class="wrap grid gap-12 py-20 md:py-28 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <h2 id="form-title" class="text-[2.5rem] font-medium leading-[1.04] tracking-[-0.03em] md:text-[3.75rem]">{t.title}</h2>
      <p class="mt-5 max-w-[38ch] text-[1.0625rem] leading-relaxed">{t.lead}</p>
      <a href={site.phone.href} class="mt-10 inline-flex items-center gap-3 font-display text-[1.75rem] font-medium tracking-[-0.01em] tabular underline decoration-ink/25 decoration-1 underline-offset-[0.18em] hover:decoration-ink md:text-[2.25rem]">
        <Icon name="phone" class="size-7" />{site.phone.display}
      </a>
    </div>

    <form
      class="lg:col-span-7"
      method="post"
      action="/api/lead"
      novalidate
      data-lead-form
      data-lang={lang}
      data-msg={JSON.stringify({ phone: t.errPhone, name: t.errName, consent: t.errConsent, sending: t.sending, submit: t.submit })}
      data-wa={site.whatsapp}
      data-wa-text={JSON.stringify(lang === 'es'
        ? { hello: 'Hola, quiero pedir cita en Smile House.', name: 'Nombre', phone: 'Teléfono', by: 'Prefiero', reason: 'Motivo', call: 'llamada', whatsapp: 'WhatsApp' }
        : { hello: 'Здравствуйте! Хочу записаться в Smile House.', name: 'Имя', phone: 'Телефон', by: 'Удобнее', reason: 'Повод', call: 'звонок', whatsapp: 'WhatsApp' })}
    >
      <input type="hidden" name="lang" value={lang} />
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label class="field-label" for="lead-name">{t.name}</label>
          <input class="field" id="lead-name" name="name" type="text" autocomplete="name" required maxlength="80" aria-describedby="lead-name-err" />
          <p class="mt-2 hidden items-center gap-1.5 text-[0.875rem] font-medium" id="lead-name-err" data-err="name"><Icon name="warning" class="size-4" /><span></span></p>
        </div>
        <div>
          <label class="field-label" for="lead-phone">{t.phone}</label>
          <input class="field tabular" id="lead-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required maxlength="24" aria-describedby="lead-phone-hint lead-phone-err" />
          <p class="mt-2 text-[0.8125rem] text-ink/70" id="lead-phone-hint">{t.phoneHint}</p>
          <p class="mt-1 hidden items-center gap-1.5 text-[0.875rem] font-medium" id="lead-phone-err" data-err="phone"><Icon name="warning" class="size-4" /><span></span></p>
        </div>
      </div>

      <fieldset class="mt-6">
        <legend class="field-label">{t.contactBy}</legend>
        <div class="grid grid-cols-2 gap-2 sm:inline-grid sm:grid-cols-[auto_auto]">
          {[
            { v: 'call', l: t.byCall, icon: 'phone' as const },
            { v: 'whatsapp', l: t.byWhatsapp, icon: 'whatsapp' as const },
          ].map((o, i) => (
            <label class="choice">
              <input type="radio" name="contactBy" value={o.v} checked={i === 0} class="sr-only" />
              <span><Icon name={o.icon} class="size-[1.125rem]" />{o.l}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="mt-6">
        <label class="field-label" for="lead-reason">{t.reason}</label>
        <div class="relative">
          <select class="field appearance-none pr-10" id="lead-reason" name="reason">
            <option value="">{t.reasonPlaceholder}</option>
            {t.reasons.map((r) => <option>{r}</option>)}
          </select>
          <svg class="pointer-events-none absolute right-4 top-1/2 size-4 -translate-y-1/2" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"/></svg>
        </div>
      </div>

      <div class="mt-6">
        <label class="flex items-start gap-3 text-[0.9375rem] leading-relaxed">
          <input type="checkbox" name="consent" value="yes" required class="mt-1 size-5 shrink-0 accent-ink" aria-describedby="lead-consent-err" />
          <span>{t.consent} <a href={legalPath(lang)} class="underline decoration-ink/35 hover:decoration-ink">{t.privacy}</a>.</span>
        </label>
        <p class="mt-2 hidden items-center gap-1.5 text-[0.875rem] font-medium" id="lead-consent-err" data-err="consent"><Icon name="warning" class="size-4" /><span></span></p>
      </div>

      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
        <button type="submit" class="btn btn-ink sm:min-w-[12rem]" data-submit>
          <Icon name="calendar" /><span data-submit-label>{t.submit}</span>
        </button>
      </div>

      <div class="mt-6 hidden rounded-[4px] bg-ink p-5 text-porcelain" data-result="ok" role="status" tabindex="-1">
        <p class="flex items-center gap-2 font-display text-[1.25rem] font-medium"><Icon name="check" class="size-5 text-coral" />{t.okTitle}</p>
        <p class="mt-2 text-porcelain/80">{t.okText} <a href={site.phone.href} class="font-medium text-porcelain underline tabular">{site.phone.display}</a></p>
      </div>
      <div class="mt-6 hidden rounded-[4px] border-2 border-ink p-5" data-result="error" role="alert" tabindex="-1">
        <p>{t.errText}</p>
        <p class="mt-3 flex flex-wrap gap-3">
          <a href={site.phone.href} class="btn btn-ink min-h-11 tabular"><Icon name="phone" />{site.phone.display}</a>
          <a href={site.whatsapp} class="btn btn-line min-h-11" target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp</a>
        </p>
      </div>
    </form>
  </div>
</section>

<style>
  .choice span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0 1.25rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--color-ink) 30%, transparent);
    font-weight: 500;
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease, transform 160ms var(--ease-out);
    width: 100%;
  }
  .choice:active span { transform: scale(0.97); }
  .choice input:checked + span {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-porcelain);
  }
  .choice input:focus-visible + span {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }
  #cita .field {
    border-color: color-mix(in oklab, var(--color-ink) 22%, transparent);
  }
  #cita .field:focus {
    border-color: var(--color-ink);
    box-shadow: 0 0 0 3px rgb(18 18 18 / 0.12);
  }
  #cita .field[aria-invalid='true'] {
    border-color: var(--color-ink);
    border-width: 2px;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-lead-form]');
  if (form) {
    const msg = JSON.parse(form.dataset.msg!);
    const btn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const ok = form.querySelector<HTMLElement>('[data-result="ok"]')!;
    const err = form.querySelector<HTMLElement>('[data-result="error"]')!;

    const setErr = (key: string, text: string | null) => {
      const p = form.querySelector<HTMLElement>(`[data-err="${key}"]`);
      const input = form.querySelector<HTMLInputElement>(`[name="${key}"]`);
      if (!p || !input) return;
      p.querySelector('span')!.textContent = text ?? '';
      p.classList.toggle('hidden', !text);
      p.classList.toggle('flex', !!text);
      input.setAttribute('aria-invalid', text ? 'true' : 'false');
    };

    const validate = () => {
      const fd = new FormData(form);
      const name = String(fd.get('name') ?? '').trim();
      const digits = String(fd.get('phone') ?? '').replace(/\D/g, '');
      const errors: Record<string, string | null> = {
        name: name.length >= 2 ? null : msg.name,
        phone: digits.length >= 9 ? null : msg.phone,
        consent: fd.get('consent') ? null : msg.consent,
      };
      Object.entries(errors).forEach(([k, v]) => setErr(k, v));
      const first = Object.keys(errors).find((k) => errors[k]);
      if (first) form.querySelector<HTMLElement>(`[name="${first}"]`)?.focus();
      return !first;
    };

    // Без JS форма уходит обычным POST, и сервер возвращает сюда ?lead=ok|error.
    const lead = new URLSearchParams(location.search).get('lead');
    if (lead === 'ok') ok.classList.remove('hidden');
    if (lead === 'error') err.classList.remove('hidden');

    form.querySelectorAll('input').forEach((i) =>
      i.addEventListener('input', () => {
        if (i.getAttribute('aria-invalid') === 'true') setErr(i.name, null);
      }),
    );

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      ok.classList.add('hidden');
      err.classList.add('hidden');
      if (!validate()) return;

      // Демо: заявка уходит готовым сообщением в WhatsApp клиники (без сервера).
      const fd = new FormData(form);
      const w = JSON.parse(form.dataset.waText!);
      const reasonSel = form.querySelector<HTMLSelectElement>('[name="reason"]');
      const reason = reasonSel && reasonSel.value ? reasonSel.selectedOptions[0].textContent!.trim() : '';
      const lines = [
        w.hello, '',
        `${w.name}: ${String(fd.get('name')).trim()}`,
        `${w.phone}: ${String(fd.get('phone')).trim()}`,
        `${w.by}: ${fd.get('contactBy') === 'whatsapp' ? w.whatsapp : w.call}`,
      ];
      if (reason) lines.push(`${w.reason}: ${reason}`);
      const base = form.dataset.wa!.replace(/\?.*$/, '');
      window.open(`${base}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
      ok.classList.remove('hidden');
      ok.focus();
    });
  }
</script>
