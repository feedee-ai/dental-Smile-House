---
import Photo from './Photo.astro';
import Stars from './Stars.astro';
import { copy } from '../content/copy';
import { doctors } from '../content/doctors';
import { reviewById, quoteFor } from '../content/reviews';
import { site, type Lang } from '../content/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang].team;
---
<section id="equipo" class="border-t border-line bg-porcelain" aria-labelledby="team-title">
  <div class="wrap py-20 md:py-28">
    <h2 id="team-title" class="text-[2.25rem] font-medium leading-[1.08] tracking-[-0.025em] md:text-[3.25rem]">{t.title}</h2>
    <p class="mt-5 max-w-[46ch] text-[1.0625rem] leading-relaxed text-ink-soft">{t.lead}</p>

    <div class="mt-12 grid gap-12 md:mt-16 lg:grid-cols-12 lg:gap-10">
      {doctors.map((d, i) => {
        const r = reviewById(d.reviewId);
        const q = quoteFor(r, lang);
        const main = i === 0;
        return (
          <article class:list={['flex flex-col border-t-2 border-ink pt-6', main ? 'lg:col-span-6 lg:pr-8' : 'lg:col-span-3']}>
            {d.photo && (
              <img src={d.photo} alt={d.name[lang]} class="mb-6 aspect-[4/5] w-full rounded-[2px] object-cover grayscale" loading="lazy" />
            )}
            <h3 class:list={['font-medium leading-none tracking-[-0.025em]', main ? 'text-[2.75rem] md:text-[3.5rem]' : 'text-[2rem] md:text-[2.25rem]']}>
              {d.name[lang]}
            </h3>
            <p class="mt-3 text-[1rem] text-graphite">{d.role[lang]}</p>
            <figure class:list={['mt-8', main ? 'lg:mt-14' : '']}>
              <Stars class="mb-3 text-[0.9375rem] text-coral-deep" />
              <blockquote class:list={['leading-relaxed text-ink', main ? 'font-display text-[1.375rem] leading-[1.4] md:text-[1.5rem]' : 'text-[1.0625rem]']}>
                <p>«{q.text}»</p>
              </blockquote>
              <figcaption class="mt-3 text-[0.875rem] text-graphite">
                {t.reviewFrom} <span class="font-medium text-ink">{r.author}</span>,{' '}
                <a href={site.reviewsUrl} target="_blank" rel="noopener" class="underline decoration-ink/25 hover:decoration-ink">Google</a>
                {q.note && <span class="block">{q.note}</span>}
              </figcaption>
            </figure>
          </article>
        );
      })}
    </div>

    <div class="mt-16 grid gap-4 md:mt-24 md:grid-cols-12 md:gap-5">
      <figure class="md:col-span-7">
        <Photo name="team-microscope" alt={t.microscopeAlt} sizes="(min-width: 768px) 58vw, 100vw" class="aspect-[4/3] w-full rounded-[4px] object-cover object-[50%_35%] grayscale md:aspect-[6/5]" />
      </figure>
      <figure class="flex flex-col md:col-span-5">
        <Photo name="team-harvard" alt={t.harvardAlt} sizes="(min-width: 768px) 42vw, 100vw" class="aspect-square w-full rounded-[4px] object-cover grayscale" />
        <figcaption class="mt-4">
          <p class="font-display text-[1.25rem] font-medium leading-snug tracking-[-0.01em]">{t.talksTitle}</p>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-graphite">{t.harvardCaption}</p>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
