---
import Monogram from './Monogram.astro';
import Icon from './Icon.astro';
import { copy } from '../content/copy';
import { site, legalPath, type Lang } from '../content/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
---
<footer class="bg-ink pb-28 text-porcelain/75 md:pb-0">
  <div class="wrap grid gap-10 py-16 md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <Monogram class="h-12 w-auto text-porcelain" />
      <p class="mt-6 font-display text-[1.125rem] font-medium text-porcelain">{site.legalName}</p>
      <p class="mt-1 text-[0.9375rem]">{t.footer.since}</p>
    </div>
    <div class="text-[0.9375rem] leading-relaxed md:col-span-4">
      <p>{site.address.street}<br />{site.address.postalCode} {site.address.city}</p>
      <p class="mt-3"><a href={site.phone.href} class="text-porcelain tabular underline decoration-porcelain/30 hover:decoration-porcelain">{site.phone.display}</a></p>
      <p class="mt-1 tabular">{t.contact.hours[0].d}, {t.contact.hours[0].h}</p>
      <p class="mt-3">
        <a href={site.instagram.url} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-porcelain underline decoration-porcelain/30 hover:decoration-porcelain">
          <Icon name="instagram" class="size-[1.125rem]" />{site.instagram.handle}
        </a>
      </p>
    </div>
    <div class="text-[0.9375rem] leading-relaxed md:col-span-3">
      <p>
        {t.footer.registro}:{' '}
        <span class="text-porcelain">{site.registroSanitario ?? t.footer.registroPending}</span>
      </p>
      <ul class="mt-4 space-y-1">
        <li><a href={legalPath(lang)} class="underline decoration-porcelain/30 hover:text-porcelain hover:decoration-porcelain">{t.footer.legal}</a></li>
        <li><a href={`${legalPath(lang)}#cookies`} data-open-cookies class="underline decoration-porcelain/30 hover:text-porcelain hover:decoration-porcelain">{t.footer.cookies}</a></li>
      </ul>
      <p class="mt-6 text-[0.8125rem] text-porcelain/50">{t.footer.madeBy}</p>
    </div>
  </div>
</footer>
