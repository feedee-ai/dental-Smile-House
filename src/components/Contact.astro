---
import Icon from './Icon.astro';
import OpenStatus from './OpenStatus.astro';
import { copy } from '../content/copy';
import { site, type Lang } from '../content/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang].contact;
---
<section id="contacto" class="wrap py-20 md:py-28" aria-labelledby="contact-title">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <h2 id="contact-title" class="text-[2.25rem] font-medium leading-[1.08] tracking-[-0.025em] md:text-[3.25rem]">{t.title}</h2>

      <address class="mt-8 not-italic">
        <p class="font-display text-[1.5rem] font-medium leading-snug tracking-[-0.01em]">
          {site.address.street}<br />
          {site.address.postalCode} {site.address.city}
        </p>
        <p class="mt-4 max-w-[40ch] leading-relaxed text-ink-soft">{t.near}</p>
      </address>

      <div class="mt-10 border-t border-line pt-6">
        <h3 class="text-[0.9375rem] font-medium text-graphite">{t.hoursTitle}</h3>
        <dl class="mt-3 grid grid-cols-[1fr_auto] gap-y-2 text-[1.0625rem]">
          {t.hours.map((h) => (
            <>
              <dt>{h.d}</dt>
              <dd class="tabular text-right">{h.h}</dd>
            </>
          ))}
        </dl>
        <div class="mt-4"><OpenStatus lang={lang} /></div>
      </div>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
        <a href={site.phone.href} class="btn btn-ink tabular"><Icon name="phone" />{site.phone.display}</a>
        <a href={site.mapsUrl} target="_blank" rel="noopener" class="btn btn-line"><Icon name="mapPin" />{t.route}</a>
      </div>
      <p class="mt-6 flex items-start gap-2 text-[0.9375rem] text-graphite">
        <Icon name="whatsapp" class="mt-0.5 size-[1.125rem] shrink-0" />
        <span>
          <a href={site.whatsapp} target="_blank" rel="noopener" class="font-medium text-ink underline decoration-ink/25 hover:decoration-ink">WhatsApp</a>
          {' · '}
          <a href={site.instagram.url} target="_blank" rel="noopener" class="font-medium text-ink underline decoration-ink/25 hover:decoration-ink">Instagram</a>.
          {' '}{t.dmLangs}
        </span>
      </p>
    </div>

    <div class="lg:col-span-7">
      <div
        class="map relative aspect-[4/5] overflow-hidden rounded-[4px] bg-ink sm:aspect-[4/3] lg:aspect-auto lg:h-full lg:min-h-[32rem]"
        data-map
        data-src={site.mapsEmbed}
      >
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-5 p-8 text-center text-porcelain" data-map-placeholder>
          <span class="relative flex size-14 items-center justify-center rounded-full bg-coral text-ink">
            <Icon name="mapPin" class="size-7" />
          </span>
          <p class="relative max-w-[30ch] text-[0.9375rem] text-porcelain/70">{t.mapConsent}</p>
          <button type="button" class="btn btn-line-light relative" data-map-load>{t.mapShow}</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const KEY = 'sh-consent-maps';
  const box = document.querySelector<HTMLElement>('[data-map]');

  function load() {
    if (!box || box.querySelector('iframe')) return;
    const f = document.createElement('iframe');
    f.src = box.dataset.src!;
    f.title = 'Google Maps';
    f.loading = 'lazy';
    f.referrerPolicy = 'no-referrer-when-downgrade';
    f.className = 'absolute inset-0 size-full border-0 grayscale-[0.85] contrast-[1.05]';
    box.appendChild(f);
    box.querySelector('[data-map-placeholder]')?.remove();
  }
  function granted() {
    try { return localStorage.getItem(KEY) === 'granted'; } catch { return false; }
  }

  if (granted()) load();
  document.addEventListener('sh:consent', (e) => {
    if ((e as CustomEvent).detail === 'granted') load();
  });
  box?.querySelector('[data-map-load]')?.addEventListener('click', () => {
    try { localStorage.setItem(KEY, 'granted'); } catch {}
    document.getElementById('cookie-banner')?.setAttribute('hidden', '');
    load();
  });
</script>
