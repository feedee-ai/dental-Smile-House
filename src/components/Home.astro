---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Cases from './Cases.astro';
import FirstVisit from './FirstVisit.astro';
import Team from './Team.astro';
import Services from './Services.astro';
import Reviews from './Reviews.astro';
import PhotoStrip from './PhotoStrip.astro';
import Contact from './Contact.astro';
import LeadForm from './LeadForm.astro';
import Footer from './Footer.astro';
import MobileBar from './MobileBar.astro';
import { copy } from '../content/copy';
import type { Lang } from '../content/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const alternates = { es: '/', ru: '/ru/' };
---
<Base lang={lang} title={t.meta.title} description={t.meta.description} alternates={alternates}>
  <Header lang={lang} alternates={alternates} />
  <main>
    <Hero lang={lang} />
    <Cases lang={lang} />
    <FirstVisit lang={lang} />
    <Team lang={lang} />
    <Services lang={lang} />
    <PhotoStrip lang={lang} />
    <Reviews lang={lang} />
    <Contact lang={lang} />
    <LeadForm lang={lang} />
  </main>
  <Footer lang={lang} />
  <MobileBar lang={lang} />
</Base>
